{
  "name": "mythr-prism-back",
  "version": "0.1.0",
  "private": true,
  "description": "Realtime backend for Mythr Prism remote monitors",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.33.0"
  },
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=--import=dotenv/config tsx watch src/server.ts",
    "dev:lan": "HOST=0.0.0.0 NODE_OPTIONS=--import=dotenv/config tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--import=dotenv/config vitest run"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express-rate-limit": "^7.5.1",
    "express": "^4.21.2",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "redis": "^4.7.0",
    "socket.io": "^4.8.1",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/swagger-ui-express": "^4.1.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.23",
    "@types/node": "^22.15.19",
    "@types/supertest": "^6.0.3",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
